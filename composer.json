{
    "name": "w3code/w3c-aiconnector",
    "description": "W3CODE AI Connector - Connector to different AI models",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Mehdi Guermazi",
            "email": "mehdi.guermazi@w3code.tn"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^7.9",
        "php": "^8.4",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "typo3/coding-standards": "^0.8.0",
        "typo3/testing-framework": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "W3code\\W3cAIConnector\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "W3code\\W3cAIConnector\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "w3c_aiconnector",
            "version": "14.0.0",
            "Package": {
                "providesPackages": {}
            },
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "ci:php": "php-cs-fixer fix --config=Build/php-cs-fixer/php-cs-fixer.php -v --dry-run --using-cache no --diff",
        "fix:php": "php-cs-fixer fix --config=Build/php-cs-fixer/php-cs-fixer.php"
    }
}
